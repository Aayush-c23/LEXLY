    <!-- DPDP 2023 Consent -->
    <string name="dpdp_consent_title">डीपीडीपी अधिनियम, 2023 गोपनीयता सूचना</string>
    <string name="dpdp_consent_message">डिजिटल व्यक्तिगत डेटा संरक्षण अधिनियम (DPDP), 2023 के अनुपालन में, लेक्सली आपके संवेदनशील व्यक्तिगत पहचानकर्ताओं (आधार, पैन, फ़ोन नंबर) को ट्रांसमिशन से पहले डिवाइस पर ही हटा देता है। विश्लेषण सत्र 24 घंटे के स्वचालित विलोपन (TTL) के साथ अस्थायी हैं। कोई भी आईपी या डिवाइस लॉग स्थायी रूप से संग्रहीत नहीं किया जाता है। क्या आप कानूनी विश्लेषण के लिए अपने विवरण को संसाधित करने की सहमति देते हैं?</string>
    <string name="dpdp_agree">मैं सहमत हूँ और आगे बढ़ें</string>
    <string name="dpdp_decline">रद्द करें</string>
