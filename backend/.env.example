# Environment Configuration for LEXLY Backend
ENVIRONMENT=development

# Asynchronous PostgreSQL / Supabase connection URL
# Note: For Supabase transaction pooling, use port 6543 or 5432 with asyncpg
# Format: postgresql://postgres.[project-ref]:[PASSWORD]@[HOST]:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Google Gemini API Key for 768-dim embeddings (gemini-embedding-001) & fact extraction
GEMINI_API_KEY=""

# Optional secondary/fallback LLM key
OPENAI_API_KEY=""

# Application Security & Settings
PROJECT_NAME="LEXLY Backend"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
